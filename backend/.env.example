# Application
APP_NAME=CredSaathi API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql+psycopg://credsaathi_user:credsaathi_password@localhost:5432/credsaathi


# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://credsaathi.vercel.app

# AI Microservice Integration
AI_SERVICE_URL=http://localhost:8001/api/v1/ai
AI_API_KEY=credsaathi_secret_api_key_v1
AI_SERVICE_TIMEOUT=10.0
