# CredSaathi AI Microservice Configuration
AI_SERVICE_NAME=CredSaathi AI Service
AI_ENVIRONMENT=development
AI_DEBUG=true
AI_LOG_LEVEL=INFO

# Gateway Security & Authentication
# Comma-separated list of authorized API keys for backend service authentication
AI_API_KEYS=credsaathi_secret_api_key_v1,credsaathi_frontend_key_prod,credsaathi_test_api_key

# Configurable CORS Origins (comma-separated). Leave empty in production unless explicitly configured.
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Timeout & Rate Limiting Configurations
AI_DEFAULT_TIMEOUT_SECONDS=30.0
AI_MODEL_TIMEOUT_SECONDS=60.0
AI_RATE_LIMIT_PER_MINUTE=120

# Provider & Model Settings
AI_DEFAULT_PROVIDER=mock-provider
AI_DEFAULT_MODEL_NAME=mock-llm-v1
AI_DEFAULT_MODEL_VERSION=1.0.0
AI_LLM_API_KEY=mock-key-do-not-hardcode
AI_LLM_BASE_URL=https://api.openai.com/v1
